<% content_for :title, "Issue report" %>
<% metadata = @event.metadata %>
<% status = metadata["answer_status"].presence || "Unknown" %>
<% category = metadata["issue_category"].presence || "Uncategorized" %>
<%= render "shared/mailer/eyebrow", label: "Ask Jared · #{category}" %>
<h2 style="margin:0 0 12px; color:#86d99a; font-size:20px; line-height:1.35;">Something seemed off</h2>
<p class="email-text" style="margin:0 0 20px; color:#d9e0dc; font-size:16px; line-height:1.6;"><%= h metadata["feedback"].to_s %></p>
<%= render "shared/mailer/panel", label: "Question", content: h(metadata["question"].to_s) %>
<div style="height:20px; line-height:20px;">&nbsp;</div>
<%= render "shared/mailer/panel", label: "Returned answer", content: h(metadata["answer"].to_s) %>
<div style="height:22px; line-height:22px;">&nbsp;</div>
<%= render "shared/mailer/meta_rows", rows: [["Company", @opportunity&.company || "Unknown"], ["Role", @opportunity&.role_title || "Unknown"], ["Submitted", @event.occurred_at], ["Contact", @contact.presence || "Not provided"], ["Status", status]] %>
<p style="margin:24px 0 0;"><%= render "shared/mailer/button", href: @admin_link, label: "View in Admin" %></p>
<p class="email-muted" style="margin:24px 0 0; color:#929e98; font-size:12px; line-height:1.5;"><strong class="email-text" style="color:#d9e0dc;">Diagnostics</strong><br>Intent: <%= h(metadata["question_intent"].presence || "Unknown") %> · Model: <%= h(metadata["model"].presence || "Unknown") %> · Latency: <%= h(metadata["latency_ms"].presence || "Not recorded") %><br>Evidence count: <%= h(metadata["evidence_count"].presence || Array(metadata["evidence_ids"]).length) %> · Validation: <%= h(metadata["validation"].presence || "Not available") %></p>
