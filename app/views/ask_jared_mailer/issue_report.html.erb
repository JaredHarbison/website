<% content_for :title, "Issue report" %>
<% metadata = @event.metadata %>
<% status = metadata["answer_status"].presence || "Unknown" %>
<% category = metadata["issue_category"].presence || "Uncategorized" %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr><td style="padding:0 0 20px;"><span style="display:inline-block; padding:6px 10px; border:1px solid #e5b566; color:#e5b566; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:.8px; text-transform:uppercase;"><%= h category %></span> <span style="display:inline-block; padding:6px 10px; background:#26302c; color:#929e98; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:.8px; text-transform:uppercase;"><%= h status %></span></td></tr>
  <tr><td style="padding:0 0 22px;"><h2 style="margin:0 0 8px; color:#86d99a; font-size:20px; line-height:1.35;">Something seemed off</h2><p style="margin:0; color:#d9e0dc; font-size:16px; line-height:1.6;"><%= h metadata["feedback"].to_s %></p></td></tr>
  <tr><td style="padding:18px 20px; background:#101817; border-left:3px solid #e5b566;"><p style="margin:0 0 7px; color:#e5b566; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:1px; text-transform:uppercase;">Question</p><p style="margin:0; color:#d9e0dc; font-size:15px; line-height:1.55;"><%= h metadata["question"].to_s %></p></td></tr>
  <tr><td style="padding:20px 0 0;"><p style="margin:0 0 7px; color:#75bfff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:1px; text-transform:uppercase;">Returned answer</p><p style="margin:0; color:#d9e0dc; font-size:15px; line-height:1.6;"><%= h metadata["answer"].to_s %></p></td></tr>
  <tr><td style="padding:22px 0 0;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-top:1px solid #26302c;"><% [["Company", @opportunity&.company], ["Role", @opportunity&.role_title], ["Submitted", @event.occurred_at], ["Contact", @contact.presence || "Not provided"]].each do |label, value| %><tr><td style="width:34%; padding:9px 12px 9px 0; color:#75bfff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:.5px; text-transform:uppercase; vertical-align:top;"><%= h label %></td><td style="padding:9px 0; color:#929e98; font-size:13px; line-height:1.45; vertical-align:top; word-break:break-word;"><%= h value.to_s %></td></tr><% end %></table></td></tr>
  <tr><td style="padding:24px 0 0;"><a href="<%= h @admin_link %>" style="display:inline-block; padding:12px 18px; background:#86d99a; color:#080b0c; font-size:14px; font-weight:700; line-height:1.2; text-decoration:none;">View in Admin</a></td></tr>
  <tr><td style="padding:24px 0 0; color:#929e98; font-size:12px; line-height:1.5;"><strong style="color:#d9e0dc;">Diagnostics</strong><br>Intent: <%= h(metadata["question_intent"].presence || "Unknown") %> · Model: <%= h(metadata["model"].presence || "Unknown") %> · Latency: <%= h(metadata["latency_ms"].presence || "Not recorded") %><br>Evidence count: <%= h(metadata["evidence_count"].presence || Array(metadata["evidence_ids"]).length) %> · Validation: <%= h(metadata["validation"].presence || "Not available") %></td></tr>
</table>
