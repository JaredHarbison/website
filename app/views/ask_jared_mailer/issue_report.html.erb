<% metadata = @event.metadata %>
<% status = metadata["answer_status"].presence || "Unknown" %>
<% category = metadata["issue_category"].presence || "Uncategorized" %>
<% company = @opportunity&.company.presence || "Unknown" %>
<% role = @opportunity&.role_title.presence || "Unknown" %>
<% context_rows = [["Company", company], ["Role", role], ["Opportunity", @opportunity&.id || "Unknown"], ["Submitted", @event.occurred_at], ["Session", "#{@event.session_digest.to_s.first(12)}…"]] %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
  <tr><td style="padding:0 0 20px;"><span style="display:inline-block; padding:6px 10px; border:1px solid #b58b42; color:#765719; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:.8px; text-transform:uppercase;"><%= h category %></span> <span style="display:inline-block; padding:6px 10px; background:#eee9df; color:#5d5750; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:.8px; text-transform:uppercase;"><%= h status %></span></td></tr>
  <tr><td style="padding:0 0 20px;"><h2 style="margin:0 0 8px; color:#252321; font-size:18px; line-height:1.35;">Something seemed off</h2><p style="margin:0; color:#252321; font-size:16px; line-height:1.6;"><%= h metadata["feedback"].to_s %></p></td></tr>
  <tr><td style="padding:18px 20px; background:#f4f1eb; border-left:3px solid #b58b42;"><p style="margin:0 0 7px; color:#765719; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:1px; text-transform:uppercase;">Question</p><p style="margin:0; font-size:15px; line-height:1.55;"><%= h metadata["question"].to_s %></p></td></tr>
  <tr><td style="padding:20px 0 0;"><p style="margin:0 0 7px; color:#765719; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:1px; text-transform:uppercase;">Returned answer</p><p style="margin:0; font-size:15px; line-height:1.6;"><%= h metadata["answer"].to_s %></p></td></tr>
  <tr><td style="padding:22px 0 0;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border-top:1px solid #d9d3ca;">
    <% context_rows.each do |label, value| %><tr><td style="width:34%; padding:9px 12px 9px 0; color:#765719; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:.5px; text-transform:uppercase; vertical-align:top;"><%= h label %></td><td style="padding:9px 0; color:#5d5750; font-size:13px; line-height:1.45; vertical-align:top; word-break:break-word;"><%= h value.to_s %></td></tr><% end %>
    <tr><td style="width:34%; padding:9px 12px 9px 0; color:#765719; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; text-transform:uppercase; vertical-align:top;">Contact</td><td style="padding:9px 0; color:#5d5750; font-size:13px; line-height:1.45; word-break:break-word;"><%= h(@contact.presence || "Not provided") %></td></tr>
  </table></td></tr>
  <tr><td style="padding:24px 0 0;"><a href="<%= h @admin_link %>" style="display:inline-block; padding:12px 18px; background:#252321; color:#fffdf9; font-size:14px; font-weight:600; line-height:1.2; text-decoration:none;">View in Admin</a></td></tr>
  <tr><td style="padding:24px 0 0; color:#81796f; font-size:12px; line-height:1.5;"><strong style="color:#5d5750;">Diagnostics</strong><br>Intent: <%= h(metadata["question_intent"].presence || "Unknown") %> · Model: <%= h(metadata["model"].presence || "Unknown") %><br>Evidence: <%= h(Array(metadata["evidence_ids"]).join(", ").presence || "Not available") %><br>Validation: <%= h(metadata["validation"].presence || "Not available") %></td></tr>
</table>
