<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow, noarchive">
<% end %>

<main class="site-main content-page ask-page" aria-labelledby="ask-title">
  <% if @ask_unavailable %>
    <p class="eyebrow">Recruiter access</p>
    <h1 id="ask-title">Ask About Jared</h1>
    <p class="lede">This experience is available through a private AskLink.</p>
    <p>Ask About Jared links are shared directly with hiring teams and are not open as a public chatbot.</p>
    <p><%= link_to "Return to portfolio", root_path, class: "button-link" %></p>
  <% else %>
  <p class="eyebrow"><%= @admin_preview ? "Owner preview" : "Recruiter access" %></p>
  <header class="page-header">
    <h1 id="ask-title">Ask About Jared</h1>
    <p class="lede">Ask about my work, experience, product thinking, or how I approach building products.</p>
  </header>
  <section class="ask-card" data-ask-controller data-ask-endpoint="/api/ask/questions" data-resume-available="<%= ApprovedResume.delivery_ready? %>" aria-live="polite">
    <details class="ask-disclosure">
      <summary>About Ask Jared</summary>
      <p>Ask Jared is an evolving side project for recruiters and hiring teams who want a quick, useful starting point. It can help with questions about my engineering experience, product decisions, collaboration, and how I approach building and shipping software. Answers are grounded in a deliberately approved career knowledge base and stay within what that evidence supports. It is meant to supplement, not replace, a conversation with me; if something seems unclear or off, feedback is genuinely welcome.</p>
    </details>
    <p><%= @admin_preview ? "Preview this experience using your owner session. This preview does not create prospect activity records." : "Ask about my experience, work, product thinking, or how I approach engineering. Follow-up questions work too." %></p>

    <div data-ask-target="body">
      <div data-ask-history></div>
      <form class="ask-form" action="/api/ask/questions" method="post" data-ask-form>
        <% unless @admin_preview %><input type="hidden" name="t" value="<%= prospect_token %>"><% end %>
        <% if @admin_preview %><input type="hidden" name="admin_preview" value="1"><% end %>
        <% if @admin_preview %><%= hidden_field_tag :authenticity_token, form_authenticity_token %><% end %>
        <label for="ask-question">Your question</label>
        <textarea id="ask-question" name="question" rows="5" maxlength="600" required placeholder="What kind of engineer is Jared?" data-ask-question></textarea>
        <button class="button-link button-link--primary" type="submit" data-ask-submit>Ask About Jared</button>
      </form>
    </div>
    <dialog class="ask-issue-modal" data-ask-issue-modal aria-labelledby="ask-issue-title">
      <form method="dialog" class="ask-issue-form" data-ask-issue-form>
        <h2 id="ask-issue-title">Something seem off?</h2>
        <label for="ask-issue-category">What kind of issue?</label>
        <select id="ask-issue-category" name="category"><option>Incorrect fact</option><option>Confusing answer</option><option>Missing context</option><option>Technical issue</option><option>Other</option></select>
        <label for="ask-issue-feedback">What seemed off?</label>
        <textarea id="ask-issue-feedback" name="feedback" rows="4" required></textarea>
        <label for="ask-issue-contact">Contact (optional)</label>
        <input id="ask-issue-contact" name="contact" type="text" autocomplete="email">
        <div class="ask-issue-form__actions"><button type="button" class="button-link" data-ask-issue-cancel>Cancel</button><button type="submit" class="button-link button-link--primary" data-ask-issue-submit>Send feedback</button></div>
        <p class="ask-issue-form__status" data-ask-issue-status role="status"></p>
      </form>
    </dialog>
  </section>
  <% end %>
</main>
