<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "Ask Jared issue report" %></title>
  </head>
  <body style="margin:0; padding:0; background:#f4f1eb; color:#252321; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background:#f4f1eb;">
      <tr><td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:640px; width:100%; background:#fffdf9; border:1px solid #d9d3ca;">
          <tr><td style="padding:24px 28px; background:#252321; color:#fffdf9;">
            <p style="margin:0 0 8px; color:#d8c7a5; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; letter-spacing:1.5px; text-transform:uppercase;">Ask Jared</p>
            <h1 style="margin:0; font-size:24px; line-height:1.2; font-weight:600;">Issue report</h1>
          </td></tr>
          <tr><td style="padding:28px;"><%= yield %></td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
