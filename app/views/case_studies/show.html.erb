<main class="site-main content-page case-study-page" aria-labelledby="page-title">
  <p class="eyebrow">Case Study</p>
  <h1 id="page-title"><%= @case_study.title %></h1>
  <p class="lede"><%= @case_study.summary %></p>
  <%= render "content/tags", entry: @case_study if @case_study.tags.any? %>
  <% if @case_study["hero_image"].present? %>
    <%= image_tag @case_study["hero_image"],
      class: "case-study-hero",
      alt: @case_study["hero_alt"].presence || @case_study.title %>
  <% end %>
  <%= MarkdownRenderer.render(@case_study.body) %>
</main>
