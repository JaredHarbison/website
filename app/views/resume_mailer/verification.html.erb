<% content_for :title, "Verify résumé request" %>
<%= render "shared/mailer/eyebrow", label: "Résumé request" %>
<h2 style="margin:0 0 18px; color:#86d99a; font-size:20px; line-height:1.35;">Confirm your email address</h2>
<p class="email-text" style="margin:0 0 18px; color:#d9e0dc; font-size:16px; line-height:1.6;">Someone requested Jared’s approved résumé using this email address. Verify that you control it before the file is sent.</p>
<p style="margin:24px 0;"><%= render "shared/mailer/button", href: @verification_url, label: "Verify email address" %></p>
<p class="email-muted" style="margin:0; color:#929e98; font-size:13px; line-height:1.5;">This one-time link expires in 20 minutes. If you did not request a résumé, you can ignore this message.</p>
