<% content_for :title, "Admin overview · Ask Jared" %>

<main class="site-main admin-main" aria-labelledby="admin-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header">
    <p class="eyebrow">Ask Jared / Admin</p>
    <h1 id="admin-title">Overview</h1>
    <p class="admin-lede">A compact operating view of Prospect access: health, meaningful prospect use, what needs attention, and what happened recently.</p>
  </header>

  <section aria-labelledby="health-title">
    <div class="admin-section-heading"><h2 id="health-title">At a glance</h2><%= link_to "Open System", admin_system_path, class: "admin-text-link" %></div>
    <div class="admin-summary-grid">
      <%= link_to admin_opportunities_path(filter: "engaged"), class: "admin-summary-card" do %><span class="admin-summary-card__label">Engaged prospects</span><strong class="admin-summary-card__value"><%= @engaged_prospects %></strong><span class="admin-summary-card__action">View journeys →</span><% end %>
      <%= link_to admin_opportunities_path, class: "admin-summary-card" do %><span class="admin-summary-card__label">Meaningful sessions</span><strong class="admin-summary-card__value"><%= @meaningful_sessions %></strong><span class="admin-summary-card__action">View Prospects →</span><% end %>
      <%= link_to admin_opportunities_path, class: "admin-summary-card" do %><span class="admin-summary-card__label">Questions asked</span><strong class="admin-summary-card__value"><%= @question_count %></strong><span class="admin-summary-card__action">Inspect activity →</span><% end %>
      <%= link_to admin_issues_path(status: "new"), class: "admin-summary-card" do %><span class="admin-summary-card__label">Outstanding issues</span><strong class="admin-summary-card__value"><%= @open_issue_count %></strong><span class="admin-summary-card__action">Review inbox →</span><% end %>
    </div>
  </section>

  <% if @direct_share_link %><section class="admin-panel admin-generated-link" aria-live="polite"><p class="admin-meta">New access link — copy it now; the bearer value is not recoverable later.</p><code><%= @direct_share_link %></code><p><%= link_to "Manage Prospects", admin_opportunities_path, class: "admin-text-link" %></p></section><% end %>

  <section class="admin-panel" aria-labelledby="attention-title">
    <div class="admin-section-heading"><h2 id="attention-title">Needs attention</h2><span class="admin-meta"><%= @mail_configured ? "Issue email configured" : "Issue email not configured" %></span></div>
    <ul class="admin-recent-list">
      <li><span><strong><%= @missing_embeddings_count %></strong> recruiter-visible entries missing embeddings</span><%= link_to "Check Knowledge", admin_knowledge_entries_path, class: "admin-text-link" %></li>
      <li><span><strong><%= @open_issue_count %></strong> issues remain unresolved</span><%= link_to "Open Issues", admin_issues_path(status: "new"), class: "admin-text-link" %></li>
      <% unless @resume_status[:available] %><li><span>Approved generic résumé is unavailable; delivery is intentionally disabled.</span><%= link_to "View System", admin_system_path, class: "admin-text-link" %></li><% end %>
    </ul>
  </section>

  <section class="admin-panel" aria-labelledby="activity-snapshot-title">
    <div class="admin-section-heading"><h2 id="activity-snapshot-title">Recent meaningful activity</h2><%= link_to "Open Prospects", admin_opportunities_path, class: "admin-text-link" %></div>
    <% if @recent_activity.any? %>
      <ul class="admin-recent-list">
        <% @recent_activity.each do |event| %><li><span><strong><%= event.event_type.humanize %></strong><span class="admin-meta"><%= event.opportunity&.company || "Unclassified access" %> · <%= event.metadata["question"].presence || event.metadata["message"].presence || event.metadata["page"].presence || "Activity" %></span></span><time class="admin-meta" datetime="<%= event.occurred_at.iso8601 %>"><%= event.occurred_at.in_time_zone.strftime("%b %-d, %-I:%M %p") %></time></li><% end %>
      </ul>
    <% else %><div class="admin-empty-state"><h3>No meaningful prospect activity yet</h3><p>Questions, feedback, messages, and résumé requests will appear here.</p></div><% end %>
  </section>

  <section class="admin-panel" aria-labelledby="knowledge-health-title">
    <div class="admin-section-heading"><h2 id="knowledge-health-title">Knowledge health</h2><%= link_to "Open Knowledge", admin_knowledge_entries_path, class: "admin-text-link" %></div>
    <p><strong><%= @recruiter_visible_count %></strong> recruiter-visible entries · <strong><%= @missing_embeddings_count %></strong> awaiting embeddings.</p>
  </section>
</main>
