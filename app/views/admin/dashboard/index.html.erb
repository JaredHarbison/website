<% content_for :title, "Admin overview · Ask Jared" %>

<main class="site-main admin-main" aria-labelledby="admin-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header">
    <p class="eyebrow">Ask Jared / Admin</p>
    <h1 id="admin-title">Overview</h1>
    <p class="admin-lede">Review professional evidence before it becomes available to recruiter-facing answers.</p>
  </header>

  <section class="admin-panel admin-share-panel" aria-labelledby="share-title">
    <div class="admin-section-heading">
      <div><h2 id="share-title">Ask Jared access</h2><p class="admin-meta">Preview as owner or create a time-limited direct-share link.</p></div>
      <%= link_to "Open owner preview", ask_path, class: "button-link" %>
    </div>
    <%= form_with url: admin_share_links_path, method: :post do %>
      <div class="admin-form__grid admin-share-form-grid">
        <div class="admin-field"><%= label_tag :label, "Label" %><%= text_field_tag :label, nil, required: true, placeholder: "Portfolio review" %></div>
        <div class="admin-field"><%= label_tag :company, "Company (optional)" %><%= text_field_tag :company, nil, placeholder: "Optional context" %></div>
        <div class="admin-field admin-field--wide"><%= label_tag :purpose, "Purpose" %><%= text_area_tag :purpose, nil, rows: 2, required: true, placeholder: "General engineering introduction" %></div>
        <div class="admin-field"><%= label_tag :expires_on, "Expires on (optional)" %><%= date_field_tag :expires_on %></div>
      </div>
      <%= submit_tag "Create direct-share link", class: "button-link button-link--primary" %>
    <% end %>
    <% if @direct_share_link %><div class="admin-generated-link" role="status"><p class="admin-meta">Copy this link now. The bearer value is not recoverable from Rails if lost.</p><code><%= @direct_share_link %></code></div><% end %>
    <% if @manual_opportunities.any? %>
      <ul class="admin-manual-links">
        <% @manual_opportunities.each do |opportunity| %>
          <li><span><strong><%= opportunity.role_title %></strong><span class="admin-meta"><%= opportunity.purpose %> · <%= opportunity.ask_token&.status %></span></span><%= button_to "Revoke", admin_revoke_share_link_path(opportunity), method: :delete, class: "button-link" if opportunity.ask_token&.status.in?(%w[claimed submitted]) %></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section aria-labelledby="review-status-title">
    <div class="admin-section-heading">
      <h2 id="review-status-title">Knowledge review</h2>
      <span class="admin-meta">Current entries</span>
    </div>
    <div class="admin-summary-grid">
      <% KnowledgeEntry::APPROVAL_STATUSES.each do |status| %>
        <%= link_to admin_knowledge_entries_path(status: status), class: "admin-summary-card" do %>
          <span class="admin-summary-card__label"><%= status.humanize %></span>
          <strong class="admin-summary-card__value"><%= @knowledge_counts.fetch(status, 0) %></strong>
          <span class="admin-summary-card__action">Review entries →</span>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="admin-panel" aria-labelledby="recent-title">
    <div class="admin-section-heading">
      <h2 id="recent-title">Recently updated</h2>
      <%= link_to "View all entries", admin_knowledge_entries_path, class: "admin-text-link" %>
    </div>
    <% if @recent_entries.any? %>
      <ul class="admin-recent-list">
        <% @recent_entries.each do |entry| %>
          <li>
            <%= link_to entry.title, admin_knowledge_entries_path(status: entry.approval_status), class: "admin-recent-list__title" %>
            <span class="status-badge status-badge--<%= entry.approval_status %>"><%= entry.approval_status.humanize %></span>
            <time class="admin-meta" datetime="<%= entry.updated_at.iso8601 %>"><%= entry.updated_at.to_date %></time>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="admin-empty-state">
        <h3>No knowledge entries yet</h3>
        <p>Imported and discovered evidence will appear here for review.</p>
      </div>
    <% end %>
  </section>
</main>
