<% content_for :title, "Access links · Ask Jared admin" %>
<main class="site-main admin-main" aria-labelledby="access-links-title">
  <%= render "admin/navigation" %>
  <nav class="admin-subnav" aria-label="Recruiter Intelligence sections"><%= link_to "Activity / Prospects", admin_recruiter_intelligence_path, class: "admin-subnav__link" %><%= link_to "Access Links", admin_access_links_path, class: "admin-subnav__link is-active" %><%= link_to "Create Access", admin_create_access_path, class: "admin-subnav__link" %></nav>
  <header class="admin-page-header"><p class="eyebrow">Recruiter Intelligence / Access</p><h1 id="access-links-title">Access links</h1><p class="admin-lede">Find active and historical access by label, company, role, purpose, or identifier. Raw bearer values are never shown.</p></header>
  <%= form_with url: admin_access_links_path, method: :get, class: "admin-filter-form" do %><%= search_field_tag :q, @query, placeholder: "Search company, role, purpose, or ID", aria: { label: "Search access links" } %><%= submit_tag "Search", class: "button-link button-link--compact" %><% end %>
  <% if flash[:notice] %><p class="admin-flash" role="status"><%= flash[:notice] %></p><% end %>
  <% if @access_links.any? %><div class="admin-table-wrap"><table class="admin-table"><caption class="visually-hidden">Prospect access links</caption><thead><tr><th>Label / context</th><th>Source</th><th>Status</th><th>Created</th><th>Expires</th><th>Action</th></tr></thead><tbody><% @access_links.each do |opportunity| %><tr><th scope="row"><%= link_to opportunity.role_title, admin_opportunity_path(opportunity), class: "admin-table__primary" %><span class="admin-meta"><%= opportunity.company %> · <%= opportunity.purpose %> · <%= opportunity.external_id %></span></th><td><%= opportunity.tracker_source.presence || "application" %></td><td><span class="status-badge status-badge--<%= opportunity.ask_token.status %>"><%= opportunity.ask_token.status.humanize %></span></td><td><%= opportunity.created_at.in_time_zone.strftime("%b %-d, %Y") %></td><td><%= opportunity.ask_token.expires_at&.in_time_zone&.strftime("%b %-d, %Y") || "No expiry" %></td><td><% if opportunity.tracker_source == "manual" && opportunity.ask_token.status.in?(%w[claimed submitted]) %><%= button_to "Revoke", admin_revoke_share_link_path(opportunity), method: :delete, class: "button-link button-link--compact button-link--destructive" %><% end %></td></tr><% end %></tbody></table></div><%= admin_pagination(page: @page, has_previous: @page > 1, has_next: @page < @total_pages, total_pages: @total_pages, params: params.permit(:q, :page).to_h.symbolize_keys) %><% else %><div class="admin-empty-state"><h2>No access links found</h2><p>Create a link or broaden the search.</p></div><% end %>
</main>
