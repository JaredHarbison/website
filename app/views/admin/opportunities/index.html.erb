<% content_for :title, "Recruiter intelligence · Ask Jared admin" %>

<main class="site-main admin-main" aria-labelledby="opportunities-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header">
    <p class="eyebrow">Ask Jared / Applications</p>
    <h1 id="opportunities-title">Recruiter intelligence</h1>
    <p class="admin-lede">Aggregate engagement signals for prioritization. Possible sharing is probabilistic, never an identity or viewer count.</p>
  </header>

  <% if @opportunities.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <caption class="visually-hidden">Recruiter engagement by opportunity</caption>
        <thead><tr>
          <th scope="col">Opportunity</th><th scope="col">Source</th><th scope="col">Application</th><th scope="col">Token</th>
          <th scope="col">Submitted</th><th scope="col">Last engagement</th><th scope="col">Sessions</th>
          <th scope="col">Questions</th><th scope="col">Issues</th><th scope="col">Signals</th><th scope="col">Cost</th>
        </tr></thead>
        <tbody>
          <% @opportunities.each do |summary| %>
            <% opportunity = Opportunity.find_by(external_id: summary[:external_id]) %>
            <tr>
              <th scope="row"><%= link_to "#{summary[:company]} · #{summary[:role_title]}", admin_opportunity_path(opportunity), class: "admin-table__primary" %><span class="admin-meta"><%= summary[:external_id] %></span></th>
              <td><span class="status-badge status-badge--<%= summary[:source] == "manual" ? "signal" : "none" %>"><%= summary[:source].humanize %></span></td>
              <td><span class="status-badge status-badge--<%= summary[:application_state] %>"><%= summary[:application_state].presence || "Not submitted" %></span></td>
              <td><span class="status-badge status-badge--<%= summary[:token_state] || "none" %>"><%= summary[:token_state] || "Not assigned" %></span></td>
              <td><%= summary[:submitted_at] || "—" %></td>
              <td><%= summary[:last_meaningful_engagement_at] || "—" %></td>
              <td><%= summary[:meaningful_session_count] %></td>
              <td><%= summary[:meaningful_question_count] %></td><td><%= summary[:issue_report_count] %></td>
              <td><% if summary[:possible_internal_share] %><span class="status-badge status-badge--signal">Possible share · <%= summary[:internal_share_confidence] %></span><% else %><span class="admin-meta">None indicated</span><% end %><% if summary[:follow_up_candidate] %><span class="status-badge status-badge--follow-up">Follow up</span><% end %></td>
              <td><%= summary[:usage_cost_cents] %>¢</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">
      <h2>No opportunities yet</h2>
      <p>Submitted opportunities and their meaningful Ask Jared engagement will appear here.</p>
    </div>
  <% end %>
</main>
