<% content_for :title, "Recruiter intelligence · Ask Jared admin" %>

<main class="site-main admin-main" aria-labelledby="opportunities-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header">
    <p class="eyebrow">Ask Jared / Applications</p>
    <h1 id="opportunities-title">Recruiter intelligence</h1>
    <p class="admin-lede">Prospect access records connect a company/role context to a tokenized portfolio visit. Activity is privacy-conscious: possible sharing is probabilistic, never an identity or viewer count.</p>
  </header>

  <nav class="admin-filter-tabs" aria-label="Prospect intelligence filters">
    <%= link_to "All", admin_opportunities_path, class: (@filter.blank? ? "is-active" : "") %>
    <%= link_to "Engaged", admin_opportunities_path(filter: "engaged"), class: (@filter == "engaged" ? "is-active" : "") %>
    <%= link_to "Asked questions", admin_opportunities_path(filter: "asked"), class: (@filter == "asked" ? "is-active" : "") %>
    <%= link_to "Possible sharing", admin_opportunities_path(filter: "sharing"), class: (@filter == "sharing" ? "is-active" : "") %>
    <%= link_to "Issues", admin_opportunities_path(filter: "issues"), class: (@filter == "issues" ? "is-active" : "") %>
    <%= link_to "No activity", admin_opportunities_path(filter: "no_activity"), class: (@filter == "no_activity" ? "is-active" : "") %>
    <%= link_to "Internal / QA", admin_opportunities_path(activity_class: "internal_qa"), class: (params[:activity_class] == "internal_qa" ? "is-active" : "") %>
  </nav>

  <section class="admin-panel admin-share-panel" aria-labelledby="share-title">
    <div class="admin-section-heading"><div><h2 id="share-title">Create prospect access</h2><p class="admin-meta">Create a time-limited direct-share link. The bearer value is shown once.</p></div><%= link_to "Owner preview", ask_path, class: "button-link" %></div>
    <%= form_with url: admin_share_links_path, method: :post do %><div class="admin-form__grid admin-share-form-grid"><div class="admin-field"><%= label_tag :label, "Access label" %><%= text_field_tag :label, nil, required: true, placeholder: "Portfolio review" %></div><div class="admin-field"><%= label_tag :company, "Company (optional)" %><%= text_field_tag :company %></div><div class="admin-field admin-field--wide"><%= label_tag :purpose, "Purpose" %><%= text_area_tag :purpose, nil, rows: 2, required: true %></div><div class="admin-field"><%= label_tag :expires_on, "Expires on (optional)" %><%= date_field_tag :expires_on %></div></div><%= submit_tag "Create direct-share link", class: "button-link button-link--primary" %><% end %>
    <% if flash[:direct_share_link] %><div class="admin-generated-link" role="status"><p class="admin-meta">Copy this link now. The bearer value is not recoverable from Rails if lost.</p><code><%= flash[:direct_share_link] %></code></div><% end %>
  </section>

  <% if @opportunities.any? %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <caption class="visually-hidden">Recruiter engagement by opportunity</caption>
        <thead><tr>
          <th scope="col">Opportunity</th><th scope="col">Source</th><th scope="col">Application</th><th scope="col">Token</th>
          <th scope="col">Submitted</th><th scope="col">Last engagement</th><th scope="col">Sessions</th>
          <th scope="col">Questions</th><th scope="col">Issues</th><th scope="col">Signals</th><th scope="col">Cost</th>
        </tr></thead>
        <tbody>
          <% @opportunities.each do |summary| %>
            <% opportunity = Opportunity.find_by(external_id: summary[:external_id]) %>
            <tr>
              <th scope="row"><%= link_to "#{summary[:company]} · #{summary[:role_title]}", admin_opportunity_path(opportunity), class: "admin-table__primary" %><span class="admin-meta"><%= summary[:external_id] %></span></th>
              <td><span class="status-badge status-badge--<%= summary[:source] == "manual" ? "signal" : "none" %>"><%= summary[:source].humanize %></span></td>
              <td><span class="status-badge status-badge--<%= summary[:application_state] %>"><%= summary[:application_state].presence || "Not submitted" %></span></td>
              <td><span class="status-badge status-badge--<%= summary[:token_state] || "none" %>"><%= summary[:token_state] || "Not assigned" %></span></td>
              <td><%= summary[:submitted_at] || "—" %></td>
              <td><%= summary[:last_meaningful_engagement_at] || "—" %></td>
              <td><%= summary[:meaningful_session_count] %></td>
              <td><%= summary[:meaningful_question_count] %></td><td><%= summary[:issue_report_count] %></td>
              <td><% if summary[:possible_internal_share] %><span class="status-badge status-badge--signal">Possible share · <%= summary[:internal_share_confidence] %></span><% else %><span class="admin-meta">None indicated</span><% end %><% if summary[:follow_up_candidate] %><span class="status-badge status-badge--follow-up">Follow up</span><% end %></td>
              <td><%= summary[:usage_cost_cents] %>¢</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= admin_pagination(page: @page, has_previous: @page > 1, has_next: @page < @total_pages, total_pages: @total_pages, params: params.permit(:page).to_h.symbolize_keys) %>
  <% else %>
    <div class="admin-empty-state">
      <h2>No opportunities yet</h2>
      <p>Submitted opportunities and their meaningful Ask Jared engagement will appear here.</p>
    </div>
  <% end %>
</main>
