<% content_for :title, "Create access · Ask Jared admin" %>
<main class="site-main admin-main" aria-labelledby="create-access-title">
  <%= render "admin/navigation" %>
  <nav class="admin-subnav" aria-label="Recruiter Intelligence sections"><%= link_to "Activity / Prospects", admin_recruiter_intelligence_path, class: "admin-subnav__link" %><%= link_to "Access Links", admin_access_links_path, class: "admin-subnav__link" %><%= link_to "Create Access", admin_create_access_path, class: "admin-subnav__link is-active" %></nav>
  <header class="admin-page-header"><p class="eyebrow">Recruiter Intelligence / Access</p><h1 id="create-access-title">Create access link</h1><p class="admin-lede">Create a time-limited link for a company or role. The bearer value is shown once and never appears in inventory.</p></header>
  <section class="admin-panel admin-share-panel"><%= form_with url: admin_share_links_path, method: :post do %><%= hidden_field_tag :return_to, admin_access_links_path %><div class="admin-form__grid"><div class="admin-field"><%= label_tag :label, "Access label" %><%= text_field_tag :label, nil, required: true, placeholder: "Portfolio review" %></div><div class="admin-field"><%= label_tag :company, "Company (optional)" %><%= text_field_tag :company %></div><div class="admin-field admin-field--wide"><%= label_tag :purpose, "Purpose" %><%= text_area_tag :purpose, nil, rows: 3, required: true, placeholder: "General engineering introduction" %></div><div class="admin-field"><%= label_tag :expires_on, "Expires on (optional)" %><%= date_field_tag :expires_on %></div></div><%= submit_tag "Create direct-share link", class: "button-link button-link--primary" %><% end %></section>
</main>
