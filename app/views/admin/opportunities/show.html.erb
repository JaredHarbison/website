<% content_for :title, "Opportunity detail · Ask Jared admin" %>

<main class="site-main admin-main" aria-labelledby="opportunity-title">
  <%= render "admin/navigation" %>
  <p><%= link_to "← Recruiter intelligence", admin_opportunities_path, class: "admin-back-link" %></p>
  <header class="admin-page-header">
    <p class="eyebrow">Opportunity detail</p>
    <h1 id="opportunity-title"><%= @summary[:company] %> · <%= @summary[:role_title] %></h1>
    <p class="admin-meta">Tracker ID: <code><%= @summary[:external_id] %></code></p>
  </header>

  <div class="admin-detail-grid">
    <section class="admin-panel" aria-labelledby="opportunity-status-title">
      <h2 id="opportunity-status-title">Opportunity & status</h2>
      <dl class="admin-detail-list">
        <dt>Company</dt><dd><%= @summary[:company] %></dd>
        <dt>Role</dt><dd><%= @summary[:role_title] %></dd>
        <dt>Source</dt><dd><span class="status-badge status-badge--<%= @summary[:source] == "manual" ? "signal" : "none" %>"><%= @summary[:source].humanize %></span></dd>
        <dt>Purpose</dt><dd><%= @summary[:purpose].presence || "—" %></dd>
        <dt>Application</dt><dd><span class="status-badge status-badge--<%= @summary[:application_state] %>"><%= @summary[:application_state].presence || "Not submitted" %></span></dd>
        <dt>Submitted</dt><dd><%= @summary[:submitted_at] || "—" %></dd>
        <dt>Token</dt><dd><span class="status-badge status-badge--<%= @summary[:token_state] || "none" %>"><%= @summary[:token_state] || "Not assigned" %></span></dd>
      </dl>
    </section>

    <section class="admin-panel" aria-labelledby="engagement-title">
      <h2 id="engagement-title">Engagement</h2>
      <dl class="admin-detail-list">
        <dt>First meaningful engagement</dt><dd><%= @summary[:first_meaningful_engagement_at] || "—" %></dd>
        <dt>Last meaningful engagement</dt><dd><%= @summary[:last_meaningful_engagement_at] || "—" %></dd>
        <dt>Meaningful sessions</dt><dd><%= @summary[:meaningful_session_count] %></dd>
        <dt>Questions</dt><dd><%= @summary[:meaningful_question_count] %></dd>
        <dt>Page views</dt><dd><%= @summary[:page_view_count] %></dd>
        <dt>Most recent question</dt><dd><%= @summary[:most_recent_question].presence || "—" %></dd>
        <dt>Most recent answer</dt><dd><%= @summary[:most_recent_answer_status].presence || "—" %></dd>
        <dt>Issue reports</dt><dd><%= @summary[:issue_report_count] %></dd>
        <dt>Possible internal share</dt><dd><%= @summary[:possible_internal_share] ? "Possible · #{@summary[:internal_share_confidence]} confidence" : "None indicated" %></dd>
      </dl>
    </section>

    <section class="admin-panel" aria-labelledby="usage-title">
      <h2 id="usage-title">Usage & follow-up</h2>
      <dl class="admin-detail-list">
        <dt>Ask usage cost</dt><dd><%= @summary[:usage_cost_cents] %>¢</dd>
        <dt>Follow-up candidate</dt><dd><%= @summary[:follow_up_candidate] ? "Yes" : "No" %></dd>
      </dl>
    </section>
  </div>

  <section class="admin-panel admin-activity-panel" aria-labelledby="activity-title">
    <h2 id="activity-title">Activity timeline</h2>
    <% if @events.any? %>
      <ol class="admin-activity-list">
        <% @events.each do |event| %>
          <li><time class="admin-meta" datetime="<%= event.occurred_at.iso8601 %>"><%= event.occurred_at %></time><strong><%= event.event_type.humanize %></strong>
            <% metadata = event.metadata || {} %>
            <% if metadata["question"].present? %><p><strong>Question:</strong> <%= metadata["question"] %></p><% end %>
            <% if metadata["answer"].present? %><p><strong>Answer:</strong> <%= metadata["answer"] %></p><% end %>
            <% if event.event_type == "issue_reported" %><p><strong><%= metadata["issue_category"] %>:</strong> <%= metadata["feedback"] %></p><% end %>
          </li>
        <% end %>
      </ol>
    <% else %><p class="admin-meta">No activity recorded.</p><% end %>
  </section>
</main>
