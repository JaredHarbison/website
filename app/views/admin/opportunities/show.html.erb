<% content_for :title, "Opportunity detail · Ask Jared admin" %>

<section class="admin-dashboard">
  <p><%= link_to "Recruiter intelligence", admin_opportunities_path %></p>
  <h1><%= @summary[:company] %> · <%= @summary[:role_title] %></h1>
  <p>Tracker ID: <%= @summary[:external_id] %></p>
  <dl>
    <% @summary.each do |key, value| %>
      <dt><%= key.to_s.humanize %></dt>
      <dd><%= value.nil? || value == "" ? "—" : value %></dd>
    <% end %>
  </dl>
</section>
