<% content_for :title, "System status · Ask Jared admin" %>
<main class="site-main admin-main" aria-labelledby="system-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header"><p class="eyebrow">Ask Jared / System</p><h1 id="system-title">System status</h1><p class="admin-lede">Operational signals only. Secrets, raw tokens, and provider credentials are never shown here.</p></header>
  <section class="admin-summary-grid"><div class="admin-summary-card"><span class="admin-summary-card__label">Recognized Ask model</span><strong class="admin-summary-card__value admin-summary-card__value--text"><%= @recognized_model %></strong></div><div class="admin-summary-card"><span class="admin-summary-card__label">Fallback model</span><strong class="admin-summary-card__value admin-summary-card__value--text"><%= @fallback_model %></strong></div><div class="admin-summary-card"><span class="admin-summary-card__label">Recruiter-visible entries</span><strong class="admin-summary-card__value"><%= @recruiter_count %></strong></div><div class="admin-summary-card"><span class="admin-summary-card__label">Missing embeddings</span><strong class="admin-summary-card__value"><%= @missing_embeddings %></strong></div></section>
  <section class="admin-panel"><h2>Knowledge scopes</h2><dl class="admin-detail-list"><% @knowledge_scope_counts.each do |label, count| %><dt><%= label %></dt><dd><%= count %></dd><% end %><dt>Active planning architecture</dt><dd>baseline-v1 by default; Candidate Context v1 remains authorized QA-only</dd></dl></section>
  <section class="admin-panel admin-system-list"><h2>AI &amp; retrieval</h2><dl class="admin-detail-list"><dt>Stale embeddings</dt><dd><%= @stale_embeddings %></dd><dt>Retrieval eligibility</dt><dd>Approved + recruiter-visible + current embedding. These are separate lifecycle states.</dd></dl></section>
  <section class="admin-panel admin-system-list"><h2>Reliability · last 30 days</h2><dl class="admin-detail-list"><dt>Successful substantive answers</dt><dd><%= @successful_answers %></dd><dt>Intentional insufficient/out-of-scope/refusal responses</dt><dd><%= @intentional_responses %></dd><dt>Technical/provider errors</dt><dd><%= @recent_failures %></dd><dt>Classified answer events</dt><dd><%= @recent_answers %></dd><dt>Legacy/unclassified events</dt><dd><%= @legacy_answer_count %> — historical records without richer telemetry</dd><dt>Question/session limit</dt><dd>4 prospect-facing questions per Ask conversation; backend enforcement remains active</dd><dt>Models recorded</dt><dd><%= @model_counts.map { |model, count| "#{model}: #{count}" }.join(" · ").presence || "No answer telemetry yet" %></dd></dl></section>
  <section class="admin-panel admin-system-list"><h2>Observability by period</h2><p class="admin-meta">Classified answer events and provider usage records only; older records may remain unknown.</p><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Period</th><th>Answer events</th><th>Substantive</th><th>Intentional insufficient</th><th>Provider errors</th><th>Tokens</th><th>Estimated cost</th></tr></thead><tbody><% @observability.each do |period, stats| %><tr><th scope="row"><%= period %></th><td><%= stats[:questions] %></td><td><%= stats[:substantive] %></td><td><%= stats[:intentional] %></td><td><%= stats[:provider_errors] %></td><td><%= stats[:input_tokens].positive? || stats[:output_tokens].positive? ? "#{stats[:input_tokens]} in / #{stats[:output_tokens]} out" : "Not recorded" %></td><td><%= stats[:estimated_cost_cents].positive? ? number_to_currency(stats[:estimated_cost_cents] / 100.0) + " estimated" : "Not recorded" %></td></tr><% end %></tbody></table></div></section>
  <section class="admin-panel admin-system-list"><h2>Operations</h2><dl class="admin-detail-list"><dt>Issue notifications</dt><dd><span class="status-badge status-badge--<%= @issue_email_configured ? "approved" : "needs_review" %>"><%= @issue_email_configured ? "Configured" : "Not configured" %></span></dd><dt>Approved generic résumé</dt><dd><span class="status-badge status-badge--<%= @resume_status[:delivery_ready] ? "approved" : "needs_review" %>"><%= @resume_status[:delivery_ready] ? "Ready" : "Unavailable" %></span> · <%= @resume_status[:filename] %></dd><dt>Rails lifecycle</dt><dd>Rails 8.0.5 support warning; major upgrade intentionally deferred</dd></dl></section>
</main>
