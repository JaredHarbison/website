<% content_for :title, "Feedback and issues · Ask Jared admin" %>
<main class="site-main admin-main" aria-labelledby="issues-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header"><p class="eyebrow">Ask Jared / Feedback</p><h1 id="issues-title">Feedback and issues</h1><p class="admin-lede">Review prospect-reported problems with the exact question, answer, and opportunity context attached. Diagnostics stay inside admin.</p></header>
  <nav class="admin-filter-tabs" aria-label="Issue filters"><%= link_to "All", admin_issues_path, class: (@status.blank? ? "is-active" : "") %><% Admin::IssuesController::STATUSES.each do |status| %><%= link_to status.humanize, admin_issues_path(status: status), class: (@status == status ? "is-active" : "") %><% end %></nav>
  <%= form_with url: admin_issues_path, method: :get, class: "admin-filter-form" do %><%= hidden_field_tag :status, @status if @status %><%= select_tag :category, options_for_select([["All categories", ""]] + @categories.map { |category| [ category, category ] }, @category), aria: { label: "Issue category" } %><%= submit_tag "Filter", class: "button-link button-link--compact" %><% end %>
  <% if @issues.any? %><div class="admin-entry-list"><% @issues.each do |issue| %><%= link_to admin_issue_path(issue), class: "admin-entry-card admin-card-link" do %><div class="admin-entry-card__header"><div><span class="admin-meta"><%= issue.opportunity&.company || "Unknown opportunity" %> · <%= issue.occurred_at %></span><h2><%= issue.metadata["issue_category"] %></h2></div><span class="status-badge status-badge--<%= issue.metadata["issue_status"].presence || "new" %>"><%= (issue.metadata["issue_status"].presence || "new").humanize %></span></div><p class="admin-entry-card__summary"><%= truncate(issue.metadata["feedback"].to_s, length: 280) %></p><p class="admin-meta"><%= issue.metadata["question"] %></p><span class="admin-text-link">Inspect report →</span><% end %><% end %></div><% else %><div class="admin-empty-state"><h2>No issues match this filter</h2><p>Reported feedback will appear here without exposing diagnostics to prospects.</p></div><% end %>
  <%= admin_pagination(page: @page, has_previous: @page > 1, has_next: @page < @total_pages, total_pages: @total_pages, params: params.permit(:status, :category, :page).to_h.symbolize_keys) %>
</main>
