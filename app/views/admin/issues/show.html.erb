<% content_for :title, "Issue report · Ask Jared admin" %>
<main class="site-main admin-main" aria-labelledby="issue-title">
  <%= render "admin/navigation" %>
  <p><%= link_to "← Feedback and issues", admin_issues_path, class: "admin-back-link" %></p>
  <header class="admin-page-header"><p class="eyebrow">Issue report</p><h1 id="issue-title"><%= @issue.metadata["issue_category"] %></h1><p class="admin-lede"><%= @opportunity&.company %> · <%= @opportunity&.role_title %> · <%= @issue.occurred_at %></p></header>
  <section class="admin-panel"><dl class="admin-detail-list"><dt>Status</dt><dd><%= form_with model: @issue, url: admin_issue_path(@issue), method: :patch do %><%= select_tag "engagement_event[issue_status]", options_for_select(Admin::IssuesController::STATUSES, @issue.metadata["issue_status"].presence || "new") %><%= submit_tag "Save status", class: "button-link button-link--compact" %><% end %></dd><dt>Question</dt><dd><%= @issue.metadata["question"] %></dd><dt>Answer</dt><dd><%= @issue.metadata["answer"] %></dd><dt>Feedback</dt><dd><%= @issue.metadata["feedback"] %></dd><dt>Contact</dt><dd><%= @issue.metadata["contact"].presence || "Not provided" %></dd><dt>Session</dt><dd><%= @issue.session_digest.first(12) %>…</dd><dt>Page / device</dt><dd><%= @issue.metadata["page"] %> · <%= @issue.metadata["device"] %></dd></dl></section>
  <details class="admin-review-details"><summary>Technical diagnostics</summary><dl class="admin-detail-list"><dt>Intent</dt><dd><%= @issue.metadata["question_intent"].presence || "—" %></dd><dt>Evidence IDs</dt><dd><%= Array(@issue.metadata["evidence_ids"]).join(", ").presence || "—" %></dd><dt>Model</dt><dd><%= @issue.metadata["model"].presence || "—" %></dd><dt>Validation</dt><dd><%= @issue.metadata["validation"].presence || "—" %></dd></dl></details>
</main>
