<nav class="admin-pagination" aria-label="Pagination">
  <% if has_previous %><%= link_to "‹ Previous", url_for(query.merge(page: page - 1)), class: "button-link button-link--compact" %><% end %>
  <% if total_pages.to_i > 1 %>
    <span class="admin-pagination__pages">
      <% pages = (1..total_pages).to_a; visible = pages.select { |number| number <= 2 || number > total_pages - 2 || (number - page).abs <= 1 } %>
      <% previous = nil %>
      <% visible.each do |number| %>
        <% if previous && number > previous + 1 %><span class="admin-meta" aria-hidden="true">…</span><% end %>
        <%= link_to number, url_for(query.merge(page: number)), class: "button-link button-link--compact admin-pagination__page", aria: { current: (number == page ? "page" : nil) } %>
        <% previous = number %>
      <% end %>
    </span>
  <% else %><span class="admin-meta">Page <%= page %></span><% end %>
  <% if has_next %><%= link_to "Next ›", url_for(query.merge(page: page + 1)), class: "button-link button-link--compact" %><% end %>
</nav>
