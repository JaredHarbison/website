<% content_for :title, "Knowledge entries · Ask Jared admin" %>

<main class="site-main admin-main" aria-labelledby="knowledge-title">
  <%= render "admin/navigation" %>
  <header class="admin-page-header">
    <p class="eyebrow">Ask Jared / Evidence</p>
    <h1 id="knowledge-title">Knowledge entries</h1>
    <p class="admin-lede">Entries originate from approved source material and repository/resume archaeology. Review confirms provenance, factual boundaries, visibility, and readiness; approval plus recruiter visibility and a current embedding make an entry retrievable.</p>
  </header>

  <%= form_with url: admin_knowledge_entries_path, method: :get, class: "admin-filter-form" do %><%= hidden_field_tag :status, @status if @status %><%= hidden_field_tag :visibility, @visibility if @visibility %><%= search_field_tag :q, @query, placeholder: "Search title, body, or source" %><%= submit_tag "Search", class: "button-link button-link--compact" %><% end %>

  <nav class="admin-filter-tabs" aria-label="Knowledge entry filters">
    <%= link_to "Needs review", admin_knowledge_entries_path(status: "needs_review"), class: (params[:status] == "needs_review" ? "is-active" : "") %>
    <%= link_to "Recruiter visible", admin_knowledge_entries_path(status: "approved", visibility: "recruiter_visible"), class: (params[:status] == "approved" && params[:visibility] == "recruiter_visible" ? "is-active" : "") %>
    <%= link_to "Private / internal", admin_knowledge_entries_path(visibility: "private"), class: (params[:visibility] == "private" ? "is-active" : "") %>
    <%= link_to "Rejected / archive", admin_knowledge_entries_path(status: "rejected"), class: (params[:status] == "rejected" ? "is-active" : "") %>
    <%= link_to "All", admin_knowledge_entries_path, class: (params[:status].blank? && params[:visibility].blank? ? "is-active" : "") %>
    <% KnowledgeEntry::APPROVAL_STATUSES.each do |status| %>
      <%= link_to status.humanize, admin_knowledge_entries_path(status: status), class: (params[:status] == status ? "is-active" : "") %>
    <% end %>
  </nav>

  <% if flash[:notice] %><p class="admin-flash admin-flash--notice" role="status"><%= flash[:notice] %></p><% end %>
  <% if flash[:alert] %><p class="admin-flash admin-flash--alert" role="alert"><%= flash[:alert] %></p><% end %>

  <% if @knowledge_entries.any? %>
    <div class="admin-entry-list">
      <% @knowledge_entries.each do |entry| %>
        <article class="admin-entry-card">
          <div class="admin-entry-card__header">
            <div>
              <span class="admin-meta"><%= entry.entry_type.humanize %> · <%= entry.source_type.humanize %></span>
              <h2><%= entry.title %></h2>
            </div>
            <span class="status-badge status-badge--<%= entry.approval_status %>"><%= entry.approval_status.humanize %></span>
          </div>
          <p class="admin-entry-card__summary"><%= entry.short_body.presence || truncate(entry.body, length: 280) %></p>
          <p class="admin-meta">Updated <%= entry.updated_at.to_date %> · Source: <%= entry.source_reference.presence || "Not specified" %></p>
          <details class="admin-review-details"><summary>Provenance and recruiter readiness</summary><dl class="admin-detail-list"><dt>Origin</dt><dd><%= entry.source_type.humanize %></dd><dt>Source reference</dt><dd><%= entry.source_reference %></dd><dt>Visibility</dt><dd><%= entry.visibility.humanize %></dd><dt>Reviewed</dt><dd><%= entry.reviewed_by.presence || "Not reviewed" %> · <%= entry.approved_at || "Not approved" %></dd><dt>Capabilities</dt><dd><%= Array(entry.metadata["recruiter_evidence"]&.fetch("competencies", nil)).join(", ").presence || "Not recorded" %></dd></dl></details>
          <% review_flags = Array(entry.metadata["review_flags"]).compact_blank %>
          <% publication_holds = Array(entry.metadata["publication_holds"]).compact_blank %>
          <% proposed_excerpts = Array(entry.metadata["proposed_recruiter_excerpts"]).compact_blank %>
          <% ownership_review = entry.metadata["ownership_review"] %>
          <% missing_methodology = Array(entry.metadata["missing_methodology"]).compact_blank %>
          <% missing_fields = Array(entry.metadata["missing_fields"]).compact_blank %>
          <% human_review = entry.metadata["human_review"] || {} %>
          <% human_questions = Array(human_review["questions"]).compact_blank %>
          <% approval_readiness = entry.metadata["approval_readiness"] || {} %>
          <% if review_flags.any? || publication_holds.any? || proposed_excerpts.any? || ownership_review.present? || missing_methodology.any? || missing_fields.any? || human_review.present? || approval_readiness.present? %>
            <div class="admin-review-evidence">
              <% if approval_readiness["ready_for_jared_approval"].present? %><p><strong>Approval readiness:</strong> <%= approval_readiness["ready_for_jared_approval"] ? "Ready for Jared's approval review" : "Additional review required" %> — <%= approval_readiness["reason"] %></p><% end %>
              <% if human_review["status"].present? %><p><strong>Human context:</strong> <%= human_review["status"] %></p><% end %>
              <% human_questions.each do |question| %>
                <p><strong>Jared review question:</strong> <%= question["question"] %></p>
                <p class="admin-meta">Dimension: <%= question["dimension"] %> · Why it matters: <%= question["why_it_matters"] %></p>
              <% end %>
              <% if review_flags.any? %><p><strong>Review flags:</strong> <%= review_flags.to_sentence %></p><% end %>
              <% if publication_holds.any? %><p><strong>Publication holds:</strong> <%= publication_holds.to_sentence %></p><% end %>
              <% if missing_methodology.any? %><p><strong>Missing methodology:</strong> <%= missing_methodology.to_sentence %></p><% end %>
              <% if missing_fields.any? %><p><strong>Missing before approval:</strong> <%= missing_fields.to_sentence %></p><% end %>
              <% if proposed_excerpts.any? %>
                <p><strong>Proposed recruiter excerpts (approval required):</strong></p>
                <ul><% proposed_excerpts.each do |excerpt| %><li><%= excerpt %></li><% end %></ul>
              <% end %>
              <% if ownership_review.present? %>
                <p><strong>Ownership review:</strong> <%= ownership_review["review_question"] %></p>
                <ul><% Array(ownership_review["statements"]).each do |statement| %><li><%= statement %></li><% end %></ul>
              <% end %>
            </div>
          <% end %>
          <details class="admin-review-details">
            <summary>Edit review</summary>
            <%= form_with model: entry, url: admin_knowledge_entry_path(entry), method: :patch, class: "admin-form" do |form| %>
              <div class="admin-form__grid">
                <div class="admin-field admin-field--wide"><%= form.label :title %><%= form.text_field :title %></div>
                <div class="admin-field admin-field--wide"><%= form.label :body %><%= form.text_area :body, rows: 5 %></div>
                <div class="admin-field"><%= form.label :short_body %><%= form.text_area :short_body, rows: 2 %></div>
                <div class="admin-field"><%= form.label :reviewer_note %><%= form.text_area :reviewer_note, rows: 2 %></div>
                <div class="admin-field"><%= form.label :source_url %><%= form.url_field :source_url %></div>
                <div class="admin-field"><%= form.label :public_url %><%= form.url_field :public_url %></div>
                <div class="admin-field"><%= form.label :approval_status %><%= form.select :approval_status, KnowledgeEntry::APPROVAL_STATUSES %></div>
                <div class="admin-field"><%= form.label :visibility %><%= form.select :visibility, KnowledgeEntry::VISIBILITIES %></div>
              </div>
              <%= form.submit "Save review", class: "button-link button-link--primary" %>
            <% end %>
          </details>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="admin-empty-state">
      <h2>No entries match this filter</h2>
      <p>Try another review status, or return to the overview for the current inventory.</p>
    </div>
  <% end %>
  <%= admin_pagination(page: @page, has_previous: @page > 1, has_next: @page * 15 < @knowledge_count, params: params.permit(:status, :visibility, :q, :page).to_h.symbolize_keys) %>
</main>
