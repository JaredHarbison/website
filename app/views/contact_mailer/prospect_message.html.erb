<% content_for :title, "Portfolio message" %>
<%= render "shared/mailer/eyebrow", label: "New message" %>
<h2 style="margin:0 0 18px; color:#86d99a; font-size:20px; line-height:1.35;">Someone followed up from the portfolio.</h2>
<%= render "shared/mailer/panel", label: "Message", content: h(@event.metadata["message"].to_s) %>
<div style="height:20px; line-height:20px;">&nbsp;</div>
<%= render "shared/mailer/meta_rows", rows: [["From", "#{@event.metadata["name"]} <#{@event.metadata["email"]}>"], ["Context", [@opportunity&.company, @opportunity&.role_title].compact.join(" · ")] ] %>
